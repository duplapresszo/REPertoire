<Window x:Class="REPertoire.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REPertoire Workout Tracker" Height="600" Width="900"
        Background="#F3F4F6" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="REPertoire Dashboard" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="StartWorkoutBtn" Content="+ Start New Workout" Width="200" Height="45" 
                HorizontalAlignment="Right" Background="#10B981" Foreground="White" 
                FontWeight="Bold" FontSize="16" Cursor="Hand" Click="StartWorkoutBtn_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <TabControl Grid.Row="1" Background="White" BorderBrush="#E5E7EB">

            <TabItem Header="Workout History" FontSize="16">
                <Grid Margin="15">
                    <ListBox x:Name="HistoryListBox" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#1F2937"/>
                                            <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="#6B7280" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="⋮" FontSize="24" FontWeight="Bold" 
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="15,0"
                                                Foreground="#9CA3AF" Click="WorkoutOptionsBtn_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Edit" Click="EditWorkout_Click"/>
                                                    <MenuItem Header="Delete" Foreground="#EF4444" Click="DeleteWorkout_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Manage Exercises" FontSize="16">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="ExercisesListBox" Grid.Column="0" Margin="0,0,20,0" 
                         DisplayMemberPath="Name" SelectedValuePath="ExerciseID" 
                         SelectionChanged="ExercisesListBox_SelectionChanged"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Exercise Details" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="EditExerciseNameTextBox" Height="32" Padding="5" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                        <Button x:Name="AddExerciseBtn" Content="Add New" Height="35" Background="#3B82F6" Foreground="White" 
                            FontWeight="Bold" Margin="0,0,0,10" Click="AddExerciseBtn_Click"/>

                        <Button x:Name="RenameExerciseBtn" Content="Rename Selected" Height="35" Background="#F59E0B" Foreground="White" 
                            FontWeight="Bold" Margin="0,0,0,10" Click="RenameExerciseBtn_Click"/>

                        <Button x:Name="DeleteExerciseBtn" Content="Delete Selected" Height="35" Background="#EF4444" Foreground="White" 
                            FontWeight="Bold" Click="DeleteExerciseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>