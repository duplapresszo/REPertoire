<Window x:Class="REPertoire.WorkoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:REPertoire"
        mc:Ignorable="d"
        Title="WorkoutWindow" Height="500" Width="850">
    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="Workout Name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="WorkoutNameTextBox" Text="My Workout" Height="32" Padding="5" VerticalContentAlignment="Center" FontSize="16"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,15,0">
                        <TextBlock Text="Start Time" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="StartTimeTextBox" Height="32" Padding="5" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,15,0">
                        <TextBlock Text="End Time" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="EndTimeTextBox" Height="32" Padding="5" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="SaveWorkoutBtn" Grid.Column="3" Content="Save &amp; Finish" Width="150" Height="40" VerticalAlignment="Bottom"
                        Background="#10B981" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="SaveWorkoutBtn_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="4" Content="⏱ Timer" Width="80" Height="40" VerticalAlignment="Bottom" Margin="15,0,0,0"
                        Background="#3B82F6" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="ToggleTimerMenu_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,20,0">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Add Exercise to Session" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Quick Add Exercise" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewExerciseName" Height="32" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+" Width="32" Height="32" Click="QuickAddExercise_Click" Margin="5,0,0,0"/>
                                </Grid>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ExerciseComboBox" Grid.Column="0" DisplayMemberPath="Name" SelectedValuePath="ExerciseID" Height="32" Margin="0,0,10,0"/>
                                <Button x:Name="AddExerciseBtn" Grid.Column="1" Content="Add" Height="32" Background="#3B82F6" Foreground="White" FontWeight="Bold" Click="AddExerciseBtn_Click"/>
                            </Grid>
                        </StackPanel>

                        <ListBox x:Name="ActiveExercisesList" Grid.Row="1" BorderThickness="1" BorderBrush="#E5E7EB" FontSize="16" SelectionChanged="ActiveExercisesList_SelectionChanged">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove Exercise from Session" Foreground="#EF4444" Click="RemoveSessionExercise_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid x:Name="SetLoggingPanel" IsEnabled="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="SelectedExerciseHeader" Grid.Row="0" Text="Select an exercise to log sets" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Weight" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="WeightTextBox" Height="32" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Reps" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="RepsTextBox" Height="32" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="NotesTextBox" Height="32" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="LogSetBtn" Grid.Column="3" Content="Log Set" Height="32" VerticalAlignment="Bottom" 
                                Background="#3B82F6" Foreground="White" FontWeight="Bold" Click="LogSetBtn_Click"/>
                        </Grid>

                        <DataGrid x:Name="SetsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                                HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" RowBackground="White" AlternatingRowBackground="#F9FAFB">

                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit Set" Click="EditSet_Click"/>
                                    <MenuItem Header="Delete Set" Foreground="#EF4444" Click="DeleteSet_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Set" Binding="{Binding SetNumber}" Width="0.5*"/>
                                <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="1*"/>
                                <DataGridTextColumn Header="Reps" Binding="{Binding Reps}" Width="1*"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="TimerMenuPanel" Visibility="Collapsed" 
                HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="0,85,20,0" Width="220" Background="White" 
                CornerRadius="8" Padding="15" 
                Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <TextBlock Text="Rest Timer" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <Button Content="▼ Minimize" HorizontalAlignment="Right" Background="Transparent" 
                            BorderThickness="0" Foreground="#6B7280" Click="MinimizeTimer_Click" Cursor="Hand"/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="-15" Width="40" Height="40" Click="TimerMinus_Click"/>

                    <TextBlock x:Name="TimerDisplay" Grid.Column="1" Text="01:30" 
                               FontSize="32" FontWeight="Bold" TextAlignment="Center" 
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2" Content="+15" Width="40" Height="40" Click="TimerPlus_Click"/>
                </Grid>

                <Button x:Name="StartStopTimerBtn" Content="Start" Height="35" 
                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                        Click="StartStopTimer_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Border x:Name="MinimizedTimerBar" Visibility="Collapsed" 
                VerticalAlignment="Bottom" HorizontalAlignment="Stretch" 
                Background="#1F2937" Padding="15,10" Panel.ZIndex="100" Cursor="Hand" MouseLeftButtonUp="ExpandTimer_Click">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⏱ Rest Time: " Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MinimizedTimerDisplay" Text="01:30" Foreground="#10B981" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <TextBlock Text="Click to expand ▲" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>